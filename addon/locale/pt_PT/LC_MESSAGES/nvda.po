msgstr "Este complemento permite guardar ligações para uma página específica."

#. Translators: Text displayed in NVDA help.
#: addon\globalPlugins\favoriteLinks\__init__.py:192
msgid "Show document URL, press twice copies to clipboard."
msgstr "Mostrar URL do documento, pressionar duas vezes para copiar para a área de transferência."

#: addon\globalPlugins\favoriteLinks\__init__.py:203
#, python-brace-format
msgid "Copied to clipboard {URL}."
msgstr "Copiado para a área de transferência: {URL}."

#: addon\globalPlugins\favoriteLinks\__init__.py:205
msgid "Document URL not found."
msgstr "URL do documento não encontrado."

#: addon\globalPlugins\favoriteLinks\__init__.py:207
msgid "No browser window found."
msgstr "Não foi encontrada nenhuma janela do navegador."

#. Translators: Text displayed in NVDA help.
#: addon\globalPlugins\favoriteLinks\__init__.py:213
msgid "Search saved links by name or URL."
msgstr "Pesquisar ligações guardadas por nome ou URL."

#: addon\globalPlugins\favoriteLinks\__init__.py:224
msgid "Failed to load links. Please check the file."
msgstr "Falha ao carregar as ligações. Verifique o ficheiro."

#: addon\globalPlugins\favoriteLinks\__init__.py:229
msgid "No saved links found. If you had links before, the links file may have been corrupt and was reset. Please add links to begin."
msgstr "Não foram encontradas ligações guardadas. Se tinha ligações anteriormente, o ficheiro de ligações pode ter sido corrompido e foi reposto. Adicione ligações para começar."

#: addon\globalPlugins\favoriteLinks\__init__.py:237
msgid "Unable to open the search dialog."
msgstr "Não foi possível abrir o diálogo de pesquisa."

#. Translators: Text displayed in NVDA help.
#: addon\globalPlugins\favoriteLinks\__init__.py:252
msgid "Open a URL from the clipboard."
msgstr "Abrir um URL a partir da área de transferência."

#: addon\globalPlugins\favoriteLinks\__init__.py:263
msgid "Unable to read the clipboard."
msgstr "Não foi possível ler a área de transferência."

#: addon\globalPlugins\favoriteLinks\__init__.py:268
msgid "The clipboard does not contain any links."
msgstr "A área de transferência não contém ligações."

#. Translators: Text displayed in NVDA help.
#: addon\globalPlugins\favoriteLinks\__init__.py:297
msgid "Move to the next saved link in the current category."
msgstr "Mover para a próxima ligação guardada na categoria atual."

#. Translators: Text displayed in NVDA help.
#: addon\globalPlugins\favoriteLinks\__init__.py:319
msgid "Move to the previous saved link in the current category."
msgstr "Mover para a ligação guardada anterior na categoria atual."

#. Translators: Text displayed in NVDA help.
#: addon\globalPlugins\favoriteLinks\__init__.py:341
msgid "Move to the next category of saved links."
msgstr "Mover para a próxima categoria de ligações guardadas."

#: addon\globalPlugins\favoriteLinks\__init__.py:359
#: addon\globalPlugins\favoriteLinks\__init__.py:387
#, python-brace-format
msgid "{category}: Contains {count} link"
msgid_plural "{category}: Contains {count} links"
msgstr[0] "{category}: Contém {count} ligação"
msgstr[1] "{category}: Contém {count} ligações"

#. Translators: Text displayed in NVDA help.
#: addon\globalPlugins\favoriteLinks\__init__.py:369
msgid "Move to the previous category of saved links."
msgstr "Mover para a categoria anterior de ligações guardadas."

#. Translators: Text displayed in NVDA help.
#: addon\globalPlugins\favoriteLinks\__init__.py:397
msgid "Move to the first saved link in the current category."
msgstr "Mover para a primeira ligação guardada na categoria atual."

#. Translators: Text displayed in NVDA help.
#: addon\globalPlugins\favoriteLinks\__init__.py:416
msgid "Move to the last saved link in the current category."
msgstr "Mover para a última ligação guardada na categoria atual."

#. Translators: Text displayed in NVDA help.
#: addon\globalPlugins\favoriteLinks\__init__.py:435
msgid "Open the currently selected link in the default browser."
msgstr "Abrir a ligação atualmente selecionada no navegador predefinido."

#: addon\globalPlugins\favoriteLinks\__init__.py:457
#, python-brace-format
msgid "Unable to open {title}."
msgstr "Não foi possível abrir {title}."

#. Translators: Text displayed in NVDA help.
#: addon\globalPlugins\favoriteLinks\__init__.py:463
msgid "Toggle reading the URL after the link name during keyboard navigation."
msgstr "Alternar a leitura do URL após o nome da ligação durante a navegação por teclado."

#: addon\globalPlugins\favoriteLinks\__init__.py:471
msgid "Read URL after name turned on."
msgstr "Leitura do URL após o nome ativada."

#: addon\globalPlugins\favoriteLinks\__init__.py:473
msgid "Read URL after name turned off."
msgstr "Leitura do URL após o nome desativada."

